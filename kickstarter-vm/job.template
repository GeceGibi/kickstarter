#!/bin/zsh
# Copy once per app, edit these lines, put that copy's absolute path in paths.
# The last command holds the window. After it exits, this file runs from the top.
set -e
cd /absolute/path/scraper/python
python3 -m venv .venv
.venv/bin/python -m pip install -r requirements.txt
cp app.settings.example.json app.settings.json
.venv/bin/python -m app --standings
.venv/bin/python -m app --fixtures
.venv/bin/python -m app --scheduler
